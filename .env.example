# Copy to .env and run `node scripts/ensure-env.cjs` (also runs automatically
# before dev/build/start) to pin DATABASE_URL to an absolute path for this
# machine's checkout, and to generate ADMIN_USER/ADMIN_PASSWORD if missing
# (printed to the console on first run — /admin is Basic-Auth protected and
# locked out entirely if these are unset).
DATABASE_URL="file:./prisma/dev.db"
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"
