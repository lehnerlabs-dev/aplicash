# Copy to .env. Point DATABASE_URL at a Postgres database (a free local
# install, or a hosted one like Vercel Postgres/Neon/Supabase).
DATABASE_URL="postgresql://user:password@localhost:5432/aplicash"

# /admin is Basic-Auth protected and locked out entirely if these are unset.
# `npm run dev` auto-generates these into .env on first run if missing
# (see scripts/ensure-env.cjs) — change them here any time.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"
