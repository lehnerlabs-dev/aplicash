{
  "name": "aplicash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node scripts/ensure-env.cjs",
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "prestart": "node scripts/ensure-env.cjs",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "node scripts/ensure-env.cjs && prisma db seed",
    "db:migrate": "node scripts/ensure-env.cjs && prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
